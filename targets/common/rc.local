#!/bin/bash
# VM init -- networking + auto-resize root filesystem.
# QEMU passes fc_ip=, fc_gw=, fc_name=, and optionally fc_nics= on the
# kernel command line.  The management NIC (eth0) is configured from
# fc_ip / fc_gw.  Extra NICs declared via fc_nics (see ltvm --nic) are
# brought up here and optionally handed off to per-type hook scripts.

# Grow root filesystem to fill the virtual disk (overlay may be larger
# than the base image's shrunk ext4).
ROOT_DEV=$(findmnt -no SOURCE / 2>/dev/null || echo /dev/vda)
resize2fs "$ROOT_DEV" 2>/dev/null || true

FC_IP=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_ip= | cut -d= -f2)
FC_GW=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_gw= | cut -d= -f2)
FC_NAME=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_name= | cut -d= -f2)
FC_NICS=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_nics= | cut -d= -f2)
FC_NIC_IPS=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_nic_ips= | cut -d= -f2)
FC_NIC_PREFIXES=$(cat /proc/cmdline | tr ' ' '\n' | grep ^fc_nic_prefixes= \
    | cut -d= -f2)

if [ -n "${FC_IP}" ]; then
    ip addr add ${FC_IP}/24 dev eth0 2>/dev/null
    ip link set eth0 up
    ip route add default via ${FC_GW:-192.168.100.1} 2>/dev/null
    # DNS via the host bridge (which runs dnsmasq); fall back to a
    # public resolver.  Use FC_GW so a non-default --subnet works.
    echo "nameserver ${FC_GW:-192.168.100.1}" > /etc/resolv.conf
    echo "nameserver 8.8.8.8" >> /etc/resolv.conf
fi

if [ -n "${FC_NAME}" ]; then
    hostnamectl set-hostname "${FC_NAME}" 2>/dev/null || \
        hostname "${FC_NAME}"
fi

# --- Extra NICs (--nic) --------------------------------------------
# ipv4_network <addr> <prefixlen> -- print the network address.
ipv4_network() {
    local addr=$1 plen=$2 a b c d ip mask net
    IFS=. read -r a b c d <<< "${addr}"
    ip=$(( (a << 24) | (b << 16) | (c << 8) | d ))
    mask=$(( (0xFFFFFFFF << (32 - plen)) & 0xFFFFFFFF ))
    net=$(( ip & mask ))
    printf '%d.%d.%d.%d\n' \
        $(( (net >> 24) & 255 )) $(( (net >> 16) & 255 )) \
        $(( (net >> 8) & 255 )) $(( net & 255 ))
}

# setup_nic_policy_route <ifname> <addr> <prefixlen> <idx>
#
# The extra NICs share one subnet, so the main table holds one
# scope-link route per interface for the same prefix and the kernel
# uses whichever came first for everything.  Give each interface its
# own table, selected by source address, so a socket bound to this
# NIC's address egresses on this NIC -- which is what LNet does for
# each NI, and what rdma_cm's own route lookup follows when ko2iblnd
# gives it a source address.  A source that matches no rule falls
# through to main, so nothing else changes.
#
# rp_filter goes loose: the reverse lookup for a peer address in the
# main table names only the first interface, so strict mode would drop
# every packet that arrives on any of the others.
setup_nic_policy_route() {
    local ifname=$1 addr=$2 plen=$3 idx=$4
    local table=$(( 100 + idx ))
    local net

    net=$(ipv4_network "${addr}" "${plen}") || return 0

    sysctl -qw "net.ipv4.conf.${ifname}.rp_filter=2" 2>/dev/null || true
    sysctl -qw "net.ipv4.conf.${ifname}.arp_ignore=1" 2>/dev/null || true
    sysctl -qw "net.ipv4.conf.${ifname}.arp_announce=2" 2>/dev/null || true

    # Idempotent: rc.local may run again, and a stale rule pointing at
    # an address this boot did not get would silently blackhole it.
    while ip rule del table "${table}" 2>/dev/null; do :; done
    ip route flush table "${table}" 2>/dev/null || true

    ip route add "${net}/${plen}" dev "${ifname}" scope link \
        src "${addr}" table "${table}" 2>/dev/null || true
    ip rule add from "${addr}" lookup "${table}" 2>/dev/null || true
}

# fc_nics is a comma-separated list of NIC *types* in the order they
# were added on the ltvm command line.  The first entry maps to eth1,
# the second to eth2, etc. -- the mgmt NIC (eth0) is not represented
# here.  Each entry is of the form TYPE or TYPE;ARG (the ';' is a
# CSV-safe stand-in for ':' in specs like 'passthrough;0000;00;02.0').
#
# Per-type setup (bringing up an IB device under softroce, configuring
# LNet, etc.) is delegated to a hook script at
#   /usr/local/sbin/setup-nic-<type>.sh <ifname> [<arg>]
# The hook is optional; a missing hook is a warning, not an error, so
# plain 'tcp' NICs work even without any hook files on the image.
#
if [ -n "${FC_NICS}" ]; then
    # Every NIC of every VM shares ONE L2 broadcast domain (the fcbr0
    # bridge on Linux, a single socket_vmnet hub on macOS), and the
    # extra NICs additionally share one subnet.  Both make ARP flux the
    # default: an ARP request for eth2's address also reaches eth1, and
    # with arp_ignore=0 eth1 answers it with its own MAC, so the peer
    # sends everything to one rail.  Answer only for addresses owned by
    # the receiving interface, and source ARP from that interface's own
    # address.
    sysctl -qw net.ipv4.conf.all.arp_ignore=1 2>/dev/null || true
    sysctl -qw net.ipv4.conf.all.arp_announce=2 2>/dev/null || true
    idx=1
    IFS=',' read -ra _nic_entries <<< "${FC_NICS}"
    # Parallel array of per-extra-NIC IPs (fc_nic_ips=), indexed 0-based
    # against fc_nics; i.e. _nic_ips[0] is the IP for eth1.  Absent on
    # older images / older .info files -> empty array -> no address
    # assignment, just bring the iface up (same as the old behaviour).
    IFS=',' read -ra _nic_ips <<< "${FC_NIC_IPS:-}"
    # Parallel array of prefix lengths (fc_nic_prefixes=).  Each extra
    # NIC is on its OWN network, so the prefix comes from the host
    # rather than being assumed here.  Absent (older ltvm) -> 24, which
    # is what this script used to hardcode.
    IFS=',' read -ra _nic_prefixes <<< "${FC_NIC_PREFIXES:-}"
    for entry in "${_nic_entries[@]}"; do
        # Split type[;arg] -- ';' is the cmdline-safe arg separator.
        nic_type="${entry%%;*}"
        if [[ "${entry}" == *";"* ]]; then
            nic_arg="${entry#*;}"
            # Restore ':' in the arg (see the host-side substitution).
            nic_arg="${nic_arg//;/:}"
        else
            nic_arg=""
        fi
        ifname="eth${idx}"
        nic_ip="${_nic_ips[$((idx - 1))]:-}"
        nic_prefix="${_nic_prefixes[$((idx - 1))]:-24}"
        if ip link show "${ifname}" >/dev/null 2>&1; then
            ip link set "${ifname}" up 2>/dev/null || true
            if [ -n "${nic_ip}" ]; then
                # The extra NICs share one network, separate from
                # mgmt, because LNet multi-rail wants several NIs on
                # one LNet network.  No gateway: off-network traffic
                # still leaves by the mgmt default route.
                ip addr add "${nic_ip}/${nic_prefix}" dev "${ifname}" \
                    2>/dev/null || true
                setup_nic_policy_route "${ifname}" "${nic_ip}" \
                    "${nic_prefix}" "${idx}"
            fi
        else
            echo "rc.local: warning: ${ifname} not present for" \
                 "--nic ${nic_type} (is the NIC wired in QEMU?)" >&2
        fi
        hook="/usr/local/sbin/setup-nic-${nic_type}.sh"
        if [ -x "${hook}" ]; then
            "${hook}" "${ifname}" "${nic_arg}" || \
                echo "rc.local: warning: ${hook} exited non-zero for" \
                     "${ifname}" >&2
        else
            # No hook present for this type.  That's fine for plain
            # 'tcp' NICs (no extra setup needed).
            :
        fi
        idx=$((idx + 1))
    done
fi

# --- LNet config ---------------------------------------------------
# Compose /etc/modprobe.d/lnet.conf from fc_nics (plus the implicit
# mgmt tcp NIC prepended by setup-lnet-config.sh) so `modprobe lnet`
# picks up the right (net-name, interface) mappings automatically.
# Idempotent -- setup-lnet-config.sh is a pure emitter, no state.
#
# Do NOT overwrite an operator- or deploy-lustre-authored lnet.conf;
# only write when it's missing.  deploy-lustre writes lustre.conf in
# a separate file, so the two coexist.
if [ -x /usr/local/sbin/setup-lnet-config.sh ] && \
   [ ! -s /etc/modprobe.d/lnet.conf ]; then
    /usr/local/sbin/setup-lnet-config.sh /etc/modprobe.d/lnet.conf \
        2>/dev/null || true
fi

# Resolve '@ib-of-eth<N>)' placeholders the emitter left for any
# 'passthrough' NIC entries.  Must run AFTER the per-NIC hook loop
# above (so softroce rxe links exist) and AFTER the initial emitter
# call (so there's a file to rewrite).  The resolver is a no-op when
# FC_NICS contains no passthrough entries, when lnet.conf is absent
# or operator-authored, or when the non-rxe ibdev count doesn't
# match -- see setup-lnet-passthrough-resolve.sh.
if [ -x /usr/local/sbin/setup-lnet-passthrough-resolve.sh ]; then
    FC_NICS="${FC_NICS}" \
        /usr/local/sbin/setup-lnet-passthrough-resolve.sh \
            /etc/modprobe.d/lnet.conf || \
        echo "rc.local: warning: lnet passthrough resolver" \
             "exited non-zero" >&2
fi

# Disable reverse-path filtering on whatever interfaces lnet.conf ended
# up naming.  Must run LAST in this section: after the emitter (so the
# file exists) and after the passthrough resolver (so placeholders are
# gone), and after the NIC loop above (so the interfaces exist and the
# live `sysctl -w` pass actually lands).  Reads the operator's file
# too, if they authored one -- it only ever relaxes rp_filter for
# interfaces LNet was told to use.
if [ -x /usr/local/sbin/setup-lnet-rp-filter.sh ]; then
    /usr/local/sbin/setup-lnet-rp-filter.sh /etc/modprobe.d/lnet.conf || \
        echo "rc.local: warning: lnet rp_filter setup exited non-zero" >&2
fi
