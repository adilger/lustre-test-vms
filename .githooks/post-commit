#!/bin/sh
# Post-commit hook: bake the new HEAD's version (git describe against the
# vMAJOR.MINOR tag, plus the short hash) into ltvm_pkg/_build_info.py so
# `ltvm --version` reports e.g. "0.5.680+71992dd888ab" without shelling
# out to git on every import.  See ltvm_pkg/version_info.py.
#
# The generated file is gitignored; the hook overwrites it on every commit.
# Install: git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
python3 "$repo_root/ltvm_pkg/version_info.py" "$repo_root" .githooks/post-commit ||
	true
